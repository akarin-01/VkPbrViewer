#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly imageCube prefilterMap;
layout(set = 0, binding = 1) uniform samplerCube envMap;

layout(push_constant, std430) uniform PrefilterPC
{
    float roughness;    // 0..1, maps to mip level
    float mipCount;
} pc;

#include "common/constants.glsl"
#include "common/cubemap_utils.glsl"
#include "common/hammersley.glsl"
#include "common/ggx.glsl"

void main()
{
    ivec2 size = imageSize(prefilterMap).xy;
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= size.x || pixelCoord.y >= size.y)
    {
        return;
    }

    uint face = gl_WorkGroupID.z;
    vec2 faceCoord = (vec2(pixelCoord) + 0.5) / vec2(size) * 2.0 - 1.0;

    vec3 N = GetDirection(face, faceCoord);
    vec3 V = N;

    // GGX importance sampling, weighted by NdotL; the sample footprint picks the mip
    const uint SAMPLE_COUNT = 1024;
    vec3 prefilteredColor = vec3(0.0);
    float totalWeight = 0.0;

    for (uint i = 0; i < SAMPLE_COUNT; ++i)
    {
        vec2 xi = Hammersley(i, SAMPLE_COUNT);
        vec3 H = ImportanceSampleGGX(xi, N, pc.roughness);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = dot(N, L);
        if (NdotL > 0.0)
        {
            float NdotH = max(dot(N, H), 0.0);
            float HdotV = max(dot(H, V), 0.0);
            float D = DistributionGGX(NdotH, pc.roughness);

            // Solid angle of the texel vs. the sample solid angle
            float pdf = D * NdotH / (4.0 * HdotV) + 0.0001;
            float saTexel = 4.0 * PI / (6.0 * size.x * size.x);
            float saSample = 1.0 / (float(SAMPLE_COUNT) * pdf + 0.0001);
            float mipLevel = clamp(0.5 * log2(saSample / saTexel), 0.0, pc.mipCount - 1.0);

            prefilteredColor += textureLod(envMap, L, mipLevel).rgb * NdotL;
            totalWeight += NdotL;
        }
    }

    prefilteredColor /= max(totalWeight, 0.001);

    imageStore(prefilterMap, ivec3(pixelCoord, int(face)), vec4(prefilteredColor, 1.0));
}
