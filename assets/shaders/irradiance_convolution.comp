#version 450

#include "include/constants.glsl"
#include "include/cubemap_utils.glsl"
#include "include/hammersley.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform writeonly imageCube irradianceMap;
layout(set = 0, binding = 1) uniform samplerCube envMap;

layout(push_constant, std430) uniform IrradiancePC
{
    float envMip;    // source sampling lod, computed on CPU from cubemap/irradiance sizes
} pc;

void main()
{
    ivec2 size = imageSize(irradianceMap).xy;
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= size.x || pixelCoord.y >= size.y)
    {
        return;
    }

    uint face = gl_WorkGroupID.z;
    vec2 faceCoord = (vec2(pixelCoord) + 0.5) / vec2(size) * 2.0 - 1.0;

    vec3 N = GetDirection(face, faceCoord);

    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = cross(N, right);

    // Monte Carlo convolution: E(N) = (1/M) * sum(L(wi)), samples follow p(w) = cos(theta)/PI
    const uint SAMPLE_COUNT = 4096;
    vec3 irradiance = vec3(0.0);
    for (uint i = 0; i < SAMPLE_COUNT; ++i)
    {
        vec2 xi = Hammersley(i, SAMPLE_COUNT);
        float phi = 2.0 * PI * xi.x;
        float theta = acos(sqrt(xi.y));

        vec3 localDir = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
        vec3 sampleDir = mat3(right, up, N) * localDir;

        irradiance += textureLod(envMap, sampleDir, pc.envMip).rgb;
    }
    irradiance = PI * irradiance / float(SAMPLE_COUNT);

    imageStore(irradianceMap, ivec3(pixelCoord, int(face)), vec4(irradiance, 1.0));
}
